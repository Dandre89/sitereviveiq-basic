# Copy this to .env (development) or .env.production (prod) and fill in real values.
# Never commit the filled-in file.

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=sitereviveiq.com,www.sitereviveiq.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sitereviveiq.com,https://www.sitereviveiq.com
SITE_DOMAIN=sitereviveiq.com
SITE_PROTOCOL=https

POSTGRES_DB=sitereviveiq
POSTGRES_USER=sitereviveiq
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Scanner bounds (Appendix B) — these are sane Build 1 defaults, not secrets.
SCANNER_USER_AGENT=SiteReviveIQBot/0.1 (+https://sitereviveiq.com/bot)
SCANNER_MAX_PAGES=25
SCANNER_MAX_DEPTH=4
SCANNER_REQUEST_TIMEOUT=15
SCANNER_MAX_RESPONSE_BYTES=5242880
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_SCAN_SECONDS=600

TIME_ZONE=America/New_York

# Billing (optional) — leave blank to keep apps.billing.middleware's
# subscription enforcement fully off (nothing gets blocked). Set all
# three once this workspace is ready to enforce real billing. See
# apps/billing/services.py and apps/billing/views.py::stripe_webhook.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for self-serve Checkout (test mode until launch)
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_ANNUAL=
